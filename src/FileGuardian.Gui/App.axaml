<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileGuardian.Gui.App"
             RequestedThemeVariant="Light">
  <!-- ZBS Labs brand: navy #072034 (logo field), silver #8F8F8A (logo lettering). -->
  <Application.Resources>
    <Color x:Key="BrandNavy">#072034</Color>
    <Color x:Key="BrandNavyHover">#12345A</Color>
    <Color x:Key="BrandSilver">#8F8F8A</Color>
    <SolidColorBrush x:Key="BrandNavyBrush" Color="#072034" />
    <SolidColorBrush x:Key="BrandSilverBrush" Color="#8F8F8A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADDE2" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#141A22" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555D69" />
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#072034" RegionColor="#FFFFFF" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Cards -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint, SelectableTextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource BrandNavyBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandNavyHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#C9CED6" />
      <Setter Property="Foreground" Value="#59616D" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Status badge -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>

    <!-- Tabs -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- List rows -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="#ECEEF1" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.log ListBoxItem">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Selection: light navy tint keeps dark text readable -->
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DCE4EE" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CFD9E6" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F1F4F8" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected">
      <Setter Property="Foreground" Value="#141A22" />
    </Style>

    <!-- Verdict tags -->
    <Style Selector="TextBlock.verdict.suspicious"><Setter Property="Foreground" Value="#B42318" /></Style>
    <Style Selector="TextBlock.verdict.malicious"><Setter Property="Foreground" Value="#8E1010" /></Style>
    <Style Selector="TextBlock.verdict.info"><Setter Property="Foreground" Value="#3D4450" /></Style>
    <Style Selector="TextBlock.verdict.clean"><Setter Property="Foreground" Value="#1B6B3A" /></Style>
  </Application.Styles>
</Application>
